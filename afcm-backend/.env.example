# Copy to .env and edit. Every value can also be set as a real environment variable.

APP_ENV=development                     # development | production
SECRET_KEY=change-me-in-production      # production: 32+ random characters   (python -c "import secrets; print(secrets.token_urlsafe(48))")
DATABASE_URL=mysql+pymysql://afcm:afcm@localhost:3306/afcm?charset=utf8mb4

# Frontend origins allowed by CORS (comma separated) and where reset-password links point
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# What "today" means when the browser doesn't say (the frontend sends X-Timezone). IANA name, e.g. Asia/Kolkata
APP_TIMEZONE=UTC

# Development conveniences. In production run `alembic upgrade head` instead.
AUTO_CREATE_TABLES=false
SEED_ON_STARTUP=false

# --- AI food recognition ---
# stub  = placeholder that does NOT look at the photo (development only)
# onnx  = your trained model from ml/train.py, read from MODEL_DIR
# none  = the endpoint answers 503 MODEL_NOT_READY
AI_PROVIDER=stub
MODEL_DIR=models
RECOGNITION_MIN_CONFIDENCE=0.25

# --- Barcodes ---
# local = only the foods table. openfoodfacts = also ask Open Food Facts and remember the product.
BARCODE_PROVIDER=local

# --- Password-reset email. Leave SMTP_HOST empty in development and the email is printed in the API log. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AI Food Calories Meter <no-reply@example.com>
SMTP_USE_TLS=true
